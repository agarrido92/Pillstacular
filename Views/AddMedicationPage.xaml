<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Pillstacular.Views.AddMedicationPage"
    Title="Add Medication">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18"
            HorizontalOptions="Start">

            <Label Text="Medication Details"
                   FontSize="24"
                   FontAttributes="Bold" />

            <!-- Medication Name and Nickname -->
            <Grid ColumnDefinitions="249,249"
                  ColumnSpacing="12"
                  HorizontalOptions="Start">

                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="Medication Name" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Medication name" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Nickname (Optional)" />
                    <Entry x:Name="NicknameEntry"
                           Placeholder="Private nickname" />
                </VerticalStackLayout>
            </Grid>

            <!-- Dosage and Measurement Unit -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Dosage" />

                <Grid ColumnDefinitions="280,222"
                      ColumnSpacing="8"
                      HorizontalOptions="Start">

                    <Entry Grid.Column="0"
                           x:Name="StrengthEntry"
                           HeightRequest="48"
                           Placeholder="200"
                           Keyboard="Numeric" />

                    <Picker Grid.Column="1"
                            x:Name="UnitPicker"
                            HeightRequest="48"
                            SemanticProperties.Description="Measurement unit">
                        <Picker.Items>
                            <x:String>mg</x:String>
                            <x:String>mcg</x:String>
                            <x:String>g</x:String>
                            <x:String>mL</x:String>
                            <x:String>units</x:String>
                            <x:String>Other</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>
            </VerticalStackLayout>

            <!-- Medication Form and Default Quantity -->
            <Grid ColumnDefinitions="290,208"
                  ColumnSpacing="12"
                  HorizontalOptions="Start">

                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="Medication Form" />
                    <Picker x:Name="FormPicker"
                            HeightRequest="48">
                        <Picker.Items>
                            <x:String>Tablet</x:String>
                            <x:String>Capsule</x:String>
                            <x:String>Injection</x:String>
                            <x:String>Cream or Ointment</x:String>
                            <x:String>Patch</x:String>
                            <x:String>Inhaler</x:String>
                            <x:String>Drops</x:String>
                            <x:String>Other</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Default Quantity" />
                    <Entry x:Name="QuantityEntry"
                           HeightRequest="48"
                           Placeholder="Example: 1"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <!-- Scheduled Medication -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="Scheduled Medication"
                       VerticalOptions="Center" />
                <Switch x:Name="AsNeededSwitch"
                        IsToggled="False"
                        Toggled="OnScheduleToggled" />
            </HorizontalStackLayout>

            <!-- Scheduling controls -->
            <VerticalStackLayout
                x:Name="ScheduleSection"
                IsVisible="False"
                Spacing="14"
                WidthRequest="510">

                <Label Text="Reminder Days"
                       FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="12">

                    <CheckBox x:Name="SundayCheck"
                              Grid.Row="0" Grid.Column="0" />
                    <Label Text="Sun"
                           Grid.Row="0" Grid.Column="0"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="MondayCheck"
                              Grid.Row="0" Grid.Column="1" />
                    <Label Text="Mon"
                           Grid.Row="0" Grid.Column="1"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="TuesdayCheck"
                              Grid.Row="0" Grid.Column="2" />
                    <Label Text="Tue"
                           Grid.Row="0" Grid.Column="2"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="WednesdayCheck"
                              Grid.Row="0" Grid.Column="3" />
                    <Label Text="Wed"
                           Grid.Row="0" Grid.Column="3"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="ThursdayCheck"
                              Grid.Row="1" Grid.Column="0" />
                    <Label Text="Thu"
                           Grid.Row="1" Grid.Column="0"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="FridayCheck"
                              Grid.Row="1" Grid.Column="1" />
                    <Label Text="Fri"
                           Grid.Row="1" Grid.Column="1"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />

                    <CheckBox x:Name="SaturdayCheck"
                              Grid.Row="1" Grid.Column="2" />
                    <Label Text="Sat"
                           Grid.Row="1" Grid.Column="2"
                           Margin="38,0,0,0"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>

                <Label Text="Reminder Times"
                       FontAttributes="Bold" />

                <VerticalStackLayout
                    x:Name="ReminderTimesContainer"
                    Spacing="10" />

                <Button Text="+ Add Reminder Time"
                        Clicked="OnAddReminderTimeClicked"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>

            <!-- Save -->
            <Button Text="Save Medication"
                    WidthRequest="510"
                    HorizontalOptions="Start"
                    Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
